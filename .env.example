# ---- Outage Watch (Loadshedding Monitor) ----
# Copy this file to `.env` and adjust values.

# Host port exposed by the web container (nginx). Published on the host as :8030.
HTTP_PORT=8030

# Timezone used for daily/weekly/monthly/quarterly report boundaries.
# Asia/Dhaka is the default for Bangladesh.
TZ=Asia/Dhaka

# Admin panel password (bcrypt-hashed on first boot).
ADMIN_PASSWORD=AdMin@123

# JWT secret used to sign admin session tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Default ping target / interval before you configure it in the admin panel.
TARGET=8.8.8.8
PING_INTERVAL_MS=30000