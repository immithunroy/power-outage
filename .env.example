# ---- Outage Watch (Loadshedding Monitor) ----
# Copy this file to `.env` and adjust values.

# Host port exposed by the web container (nginx). Published on the host as :8030.
HTTP_PORT=8030

# Timezone used for daily/weekly/monthly/quarterly report boundaries.
# Asia/Dhaka is the default for Bangladesh.
TZ=Asia/Dhaka

# Admin panel password (bcrypt-hashed on first boot).
ADMIN_PASSWORD=AdMin@123

# JWT secret used to sign admin session tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Default ping target / interval before you configure it in the admin panel.
TARGET=8.8.8.8
PING_INTERVAL_MS=30000

# Optional: generator-connected host (e.g. camera) and IPS-connected host
# (e.g. router). Can also be set later in the admin panel; these are only
# used as first-boot defaults.
GENERATOR_TARGET=
IPS_TARGET=

# ---- Growatt Inverter Integration (Optional) ----
# Configure via Admin panel or set defaults here.
# Get your API token from: openapi.growatt.com -> Settings -> Account Management -> API Key
# GROWATT_ENABLED=false
# GROWATT_API_TOKEN=
# GROWATT_SERVER_URL=https://openapi.growatt.com
# GROWATT_PLANT_ID=
# GROWATT_DEVICE_SN=
# GROWATT_BATTERY_CAPACITY_KWH=16
# GROWATT_BATTERY_DOD=80
# GROWATT_RESERVE_SOC=20
# GROWATT_POLLING_INTERVAL_SEC=300